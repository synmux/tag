{
  "author": {
    "email": "syn@syn.as",
    "name": "syn",
    "url": "https://github.com/synmux"
  },
  "bin": {
    "tag": "src/index.ts"
  },
  "dependencies": {
    "@scure/bip39": "^2.4.0",
    "commander": "^15.0.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@trunkio/launcher": "^1.3.4",
    "@types/bun": "^1.4.2",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "skilld": "^2.3.0"
  },
  "engines": {
    "bun": "^1.4.2"
  },
  "module": "src/index.ts",
  "name": "@synmux/tag",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synmux/tag.git"
  },
  "scripts": {
    "build": "bun build --production --compile --outfile=bin/tag src/index.ts",
    "format": "bun run prettier --write . && bun run trunk fmt -a",
    "lint": "bun run trunk check -a",
    "lint:fix": "bun run trunk check -a --fix",
    "lint:types": "bun run tsc --noEmit",
    "start": "bun src/index.ts",
    "test": "bun test",
    "prepare": "skilld prepare || true"
  },
  "trustedDependencies": [
    "@google/genai",
    "onnxruntime-node",
    "protobufjs"
  ],
  "type": "module"
}
